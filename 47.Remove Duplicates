import java.util.HashSet;

class Main {
    public static void main(String[] args) {

        int arr[] = {2, 5, 6, 7, 3, 6, 8};

        HashSet<Integer> set = new HashSet<>();

        for (int i = 0; i < arr.length; i++) {
            set.add(arr[i]);
        }

        for (int num : set) {
            System.out.print(num + " ");
        }
    }
}
