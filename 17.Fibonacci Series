import java.util.Scanner;
public class Fibonacci {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter Terms: ");
        int n = sc.nextInt();

        int first = 0;
        int second = 1;
//first=0/1/
//second=1/1
//n=5
//i=1/2
0/p=1/2/

//next=0+1=1+3=4


        for (int i = 1; i <= n; i++) {
            System.out.print(first + " ");
            int next = first + second;
            first = second;
            second = next;
        }
    }
}
