import java.util.Scanner;

public class SumOfN {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter N: ");
        int n = sc.nextInt();
//n=5
//sum=0/
//i=1/2/3/4/5/6
//sum=1/3/6/10/15
        int sum = 0;

        for (int i = 1; i <= n; i++) {
            sum = sum + i;
        }

        System.out.println("Sum = " + sum);//15
    }
}
