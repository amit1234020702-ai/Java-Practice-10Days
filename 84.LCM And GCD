Input: a = 5 , b = 10
Output: [10, 5]
Explanation: LCM of 5 and 10 is 10, while their GCD is 5.
Input: a = 14 , b = 8
Output: [56, 2]
Explanation: LCM of 14 and 8 is 56, while their GCD is 2.

class Solution {
    public static int[] lcmAndGcd(int a, int b) {
        int arr[]=new int[2];
        int num1=a;
        int num2=b;
        while(b!=0){
            int temp=b;
            b=a%b;
            a=temp;
        }
        int gcd=a;
        int lcm=(num1*num2)/gcd;
        arr[0]=lcm;
        arr[1]=gcd;
        return arr;
        
        
    }
}
