Input: a = 5, b = 11
Output: 55

Explanation: LCM of 5 and 11 is 55
class Solution {
    public int lcm(int a, int b) {
        int a1=a;
        int b1=b;
        while(b!=0){
            int temp=b;
            b=a%b;
            a=temp;
        }
        int x=a;
        return(a1*b1)/x;
        
    }
}
